        {
          "name": "SETUP-03 · POST /api/users · Создать ученика",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 создан или 409 уже существует\", () =>",
                  "  pm.expect(pm.response.code).to.be.oneOf([201, 409]));",
                  "",
                  "if (pm.response.code === 201) {",
                  "  pm.environment.set(\"learnerId\", pm.response.json().id);",
                  "}",
                  "",
                  "pm.sendRequest({",
                  "  url: pm.environment.get(\"baseUrl\") + \"/api/auth/login\",",
                  "  method: \"POST\",",
                  "  header: { \"Content-Type\": \"application/json\" },",
                  "  body: { mode: \"raw\", raw: JSON.stringify({",
                  "    username: pm.environment.get(\"learnerUsername\"),",
                  "    password: pm.environment.get(\"learnerPassword\") }) }",
                  "}, (err, res) => {",
                  "  pm.test(\"ученик залогинился, learnerToken записан\", () => {",
                  "    pm.expect(err).to.be.null;",
                  "    pm.expect(res.code).to.eql(200);",
                  "  });",
                  "  if (!err) pm.environment.set(\"learnerToken\", res.json().token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
