      "name": "00 Setup",
      "item": [
        {
          "name": "SETUP-01 · POST /api/auth/login · Login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));\npm.test(\"Content-Type JSON\", () =>\n  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));\npm.test(\"Быстрее 1500 мс\", () => pm.expect(pm.response.responseTime).to.be.below(1500));\n\nconst b = pm.response.json();\npm.test(\"Есть token из 3 частей\", () => {\n  pm.expect(b).to.have.property(\"token\");\n  pm.expect(b.token.split(\".\")).to.have.lengthOf(3);\n});\npm.test(\"user.username = admin, тип SUPER_ADMIN\", () => {\n  pm.expect(b.user.username).to.eql(\"admin\");\n  pm.expect(b.user.userType).to.eql(\"SUPER_ADMIN\");\n});\npm.test(\"Нет passwordHash в ответе\", () =>\n  pm.expect(JSON.stringify(b)).to.not.include(\"passwordHash\"));\n\npm.environment.set(\"adminToken\", b.token);\npm.environment.set(\"adminId\", b.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{ \"username\": \"admin\", \"password\": \"admin123\" }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "SETUP-02 · POST /api/auth/login · Login instructor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type JSON\", () =>",
                  "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "pm.test(\"Быстрее 1500 мс\", () => pm.expect(pm.response.responseTime).to.be.below(1500));",
                  "const b = pm.response.json();",
                  "pm.test(\"Тип TRAINER\", () => pm.expect(b.user.userType).to.eql(\"TRAINER\"));",
                  "pm.test(\"нет passwordHash\", () =>",
